# Describe the target, never probe the build host for cross-compilation.
if(NOT DEFINED STREAMCIPHER_ARCH)
    set(streamcipher_processor "${CMAKE_SYSTEM_PROCESSOR}")
    if(CMAKE_GENERATOR_PLATFORM)
        set(streamcipher_processor "${CMAKE_GENERATOR_PLATFORM}")
    endif()
    if(CMAKE_OSX_ARCHITECTURES)
        # A universal binary cannot assume that every slice supports x86 intrinsics.
        set(streamcipher_processor "${CMAKE_OSX_ARCHITECTURES}")
    endif()
    if(streamcipher_processor MATCHES "^(x86_64|AMD64|amd64|x64)$")
        set(STREAMCIPHER_ARCH "x86_64")
    elseif(streamcipher_processor MATCHES "^(aarch64|ARM64|arm64)$")
        set(STREAMCIPHER_ARCH "aarch64")
    else()
        set(STREAMCIPHER_ARCH "generic")
    endif()
endif()
message(STATUS "Detected target architecture: ${STREAMCIPHER_ARCH}")
if(NOT STREAMCIPHER_ARCH STREQUAL "x86_64")
    set(STREAMCIPHER_USE_AESNI OFF)
    message(STATUS "AES-NI disabled (requires x86_64 target)")
endif()
